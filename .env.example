VIPER_ENV=development
VIPER_HOST=127.0.0.1
VIPER_PORT=3010
VIPER_LOG_LEVEL=info

# Single-owner loopback starter: two DIFFERENT random 32-byte lowercase hex strings.
VIPER_LOCAL_TOKEN=
VIPER_CURSOR_SECRET=
VIPER_ACTOR_ID=local-owner
VIPER_APP_ID=viper-local
# Optional EXISTING owner-scoped connection IDs; empty means model-only, no MCP tools.
# Starter credentials are 'none'; private/OAuth MCP requires a host credential adapter.
VIPER_MCP_CONNECTION_IDS=

# Model providers (P05-01); never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VIPER_MODEL_PROVIDER=anthropic
# Cost-oriented default for testing; claude-opus-5-5 only when an eval shows Sonnet falls short.
VIPER_MODEL=claude-sonnet-4-6
VIPER_MODEL_EFFORT=medium
VIPER_MODEL_FALLBACKS=true
# Prompt caching (X02): true | false (default true). TTL 5m for chat/agent loops, 1h only for long gaps.
VIPER_MODEL_PROMPT_CACHE=true
VIPER_MODEL_PROMPT_CACHE_TTL=5m
# OpenAI (set VIPER_MODEL_PROVIDER=openai to use it): model is required, no guessed default.
VIPER_OPENAI_MODEL=
VIPER_OPENAI_REASONING_EFFORT=
OPENAI_BASE_URL=

# New engine database only (schema viper_engine); never a V4/legacy database.
VIPER_DB_HOST=127.0.0.1
VIPER_DB_PORT=5432
VIPER_DB_NAME=viper_engine_dev
VIPER_DB_USER=postgres
VIPER_DB_PASSWORD=
VIPER_DB_SSL=false
VIPER_DB_POOL_MAX=10

# Loopback PostgreSQL server for `npm run test:integration` (creates/drops viper_it_* databases).
VIPER_TEST_DB_HOST=
VIPER_TEST_DB_PORT=5432
VIPER_TEST_DB_NAME=postgres
VIPER_TEST_DB_USER=postgres
VIPER_TEST_DB_PASSWORD=
