{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://viper.local/schemas/scenario.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^VE-[0-9]{3}$"
    },
    "family": {
      "enum": [
        "final",
        "tools",
        "clarification",
        "error",
        "resource",
        "prompt",
        "approval",
        "budget"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "contextRequests": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method": {
                "const": "resources/read"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "uri": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "uri"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method": {
                "const": "prompts/get"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "arguments": {
                    "type": "object"
                  }
                },
                "required": [
                  "name",
                  "arguments"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "modelResponses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://viper.local/schemas/model-response.json"
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "completed",
            "waiting_for_input",
            "waiting_for_approval",
            "partial",
            "failed"
          ]
        },
        "toolNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "state",
        "toolNames",
        "assertions"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "family",
    "goal",
    "contextRequests",
    "modelResponses",
    "expected"
  ]
}
