{
  "schemaVersion": 1,
  "suite": "workin-live",
  "description": "Live model trials: real Viper engine + real model + MCP Workin gateway (attendance + employees). Answers are graded by required facts, tools and approval behaviour. 40 cases; some have several user turns.",
  "environment": {
    "company": "c8f745e0-aa6e-458b-bb70-4dda3e2accea",
    "account": "SSO user with an active hris_company account for that company",
    "data": "db_employees dev (real) + db_attendance dev with the dummy seed for 10-21 November 2026 (docs/integration/workin-dummy-seed.cjs)",
    "services": "gateway_v3 8b5867b, service_attendance fe5cd28, service_employees 2c6498a",
    "approvalDecision": "approvals are REJECTED unless a case sets approvalDecision=accept (WL-026 writes one dummy-shift assignment for Agus Setiawan on 2026-11-25; workin-dummy-seed.cjs --cleanup removes it)"
  },
  "grading": {
    "status": "run status must be one of expect.status",
    "toolsAll": "every listed MCP tool (remote name) was called at least once",
    "toolsAny": "at least one listed MCP tool was called",
    "answerAll": "for every group, the final answer contains at least one alternative (case-insensitive)",
    "answerNone": "the final answer contains none of these (case-insensitive)",
    "approval": "an approval was requested for this tool (null = no approval expected)",
    "turns": "a case with `turns` sends them in order in one conversation; tools/approvals are collected over all turns, the answer is the last one"
  },
